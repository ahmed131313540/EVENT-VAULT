# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://postgres:eventvault@localhost:5432/eventvault
SECRET_KEY=change-me-to-a-long-random-string

# Optional. Without these the site runs in demo mode (no payment taken, no email sent).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=EventVault <onboarding@resend.dev>

# Optional, only needed once: every account starts as role "user", so this is how you create your
# first admin. Set both, run `python seed.py`, then leave them blank (or remove them) — the account
# already exists and re-running with these set just re-confirms it's an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
